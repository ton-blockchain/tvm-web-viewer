{
    "compilerOptions": {
        "target": "ES2020",
        "outDir": "dist",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "declaration": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "removeComments": false,
        "jsx": "react-jsx",
        "resolveJsonModule": true,
        "isolatedModules": true
    },
    "include": [
        "src/**/*",
        "src/runner/executor/emulator-emscripten.d.ts",
        "src/runner/executor/emulator-emscripten-wasm.d.ts"
    ],
    "typeRoots": ["./src/types", "./node_modules/@types"],
    "types": ["emulator-emscripten"],
    "exclude": [
        "**/*.spec.ts"
    ],
    "references": [
        { "path": "./tsconfig.node.json" }
    ]
}
